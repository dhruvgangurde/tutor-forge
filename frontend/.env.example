# Frontend build-time configuration (Vite). Copy to .env.local for local
# overrides, or set in the Vercel project settings for deploys.

# Absolute backend origin for production builds (F2). Leave UNSET in local dev
# so the app uses '/api', which Vite proxies to http://localhost:8000.
# Example (Render backend):
# VITE_API_BASE_URL=https://tutorforge-backend.onrender.com

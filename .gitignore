.dmypy.json
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Environment
.env
.env.local
.env.*.local

# ChromaDB + app data (never commit vector store or uploaded files)
backend/data/

# Node
node_modules/
frontend/dist/
frontend/.vite/


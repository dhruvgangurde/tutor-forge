# ─────────────────────────────────────────────
# TutorForge AI — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/tutorforge

# ── LLM provider ──────────────────────────────
# Which AI backend to use. Replaces the old USE_MOCK_GEMINI flag —
# if you still have USE_MOCK_GEMINI set anywhere, delete it: it no longer
# does anything, and production refuses to boot while it is present.
#
#   mock    deterministic in-process stub. No network, no quota.
#           The default, and the only provider the pytest suite uses.
#   gemini  real Gemini API. REQUIRED in production, and the only provider
#           whose results may be reported as acceptance criteria
#           (teacher acceptance / zero leakage / zero grading variance).
#   ollama  LOCAL DEV ONLY — free local models. Rejected in production.
#           See docs/OLLAMA_DEV_SETUP.md before enabling.
LLM_PROVIDER=ollama

# ── Gemini API ────────────────────────────────
# Model strings are read from env — never hardcoded in source
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# ── Ollama (LOCAL DEV ONLY) ───────────────────
# Only consulted when LLM_PROVIDER=ollama. Defaults shown; override if needed.
# qwen2.5:7b-instruct is the only validated generation model — llama3 was
# disqualified (see docs/OLLAMA-EVALUATION-2026-08-15.md).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Local models are ~10x slower than Gemini; a cold model load alone can exceed
# the 30s Gemini deadline, so this budget is deliberately much larger.
OLLAMA_TIMEOUT_SECONDS=120

# ── Groundedness thresholds ───────────────────
# One per provider — the similarity scales are NOT interchangeable.
# GROUNDEDNESS_THRESHOLD_OLLAMA is an UNTUNED PLACEHOLDER copied from the Gemini
# value; measure it against a real corpus before trusting it.
GROUNDEDNESS_THRESHOLD=0.65
GROUNDEDNESS_THRESHOLD_MOCK=0.20
GROUNDEDNESS_THRESHOLD_OLLAMA=0.65

# ── ChromaDB ──────────────────────────────────
# Defaults to backend/data/chroma if unset
# This path is relative to where uvicorn is launched (the backend/ directory)
CHROMA_PERSIST_PATH=data/chroma

# ── Langfuse ──────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── JWT ───────────────────────────────────────
# Change this to a long random string in production
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed frontend origins — no wildcard.
# Local dev (Vite): http://localhost:5173
# Production: add your deployed Vercel frontend URL, e.g.
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Reverse proxy ─────────────────────────────
# Set to true ONLY when the backend runs behind a reverse proxy that sets
# X-Forwarded-For. Rate limits then key on the address the proxy appended.
# Leave false otherwise: the header is client-controlled and is ignored.
# Behind a proxy, also start uvicorn with --forwarded-allow-ips=<proxy address>
# (or FORWARDED_ALLOW_IPS); without one, use --no-proxy-headers. See README,
# "Running behind a reverse proxy".
TRUSTED_PROXY=false

# ── Evaluation ────────────────────────────────
# Set to "true" to use real Gemini API in end-to-end eval runs
# Leave unset (or "false") to use mocked Gemini in all pytest runs
EVAL_USE_REAL_GEMINI=false
